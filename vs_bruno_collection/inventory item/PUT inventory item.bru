meta {
  name: PUT inventory item
  type: http
  seq: 10
}

put {
  url: {{baseURL}}/api/inventoryItems/{{id}}
  body: json
  auth: inherit
}

body:json {
  {
    "dateAdded": "{{dateAdded}}",
    "notes": "{{notes}}",
    "currentCheckout": {{currentCheckout_id}},
    "genDis": {{genDis_id}}
  }
}

vars:post-response {
  name: req.body.name
  description: req.body.description
  imageUrl: req.body.imageUrl
}

assert {
  res.status: eq 200
  res.body: eq {{id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
