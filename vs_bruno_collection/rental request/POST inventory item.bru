meta {
  name: POST inventory item
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/api/inventoryItems
  body: json
  auth: inherit
}

body:json {
  {
    "dateAdded": "{{$isoTimestamp}}",
    "notes": "{{$randomAdjective}}",
    "currentCheckout": null,
    "genDis": {{genDis_id}}
  }
}

vars:post-response {
  inventoryitem_id: res.body
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
