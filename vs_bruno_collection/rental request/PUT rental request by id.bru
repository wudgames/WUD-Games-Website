meta {
  name: PUT rental request by id
  type: http
  seq: 8
}

put {
  url: {{baseURL}}/api/rentalRequests/{{id}}
  body: json
  auth: inherit
}

body:json {
  {
    "requesterName": "{{requesterName}}",
    "requesterEmail": "{{requesterEmail}}",
    "submissionTime": "{{submissionTime}}",
    "startDate": "{{startDate}}",
    "endDate": "{{endDate}}",
    "requesterComments": "{{requesterComments}}",
    "adminComments": "{{adminComments}}",
    "status": "APPROVED",
    "checkoutRecord": {{checkoutrecord_id}},
    "requestedInventory": [{{inventoryitem_id}}]
  }
}

vars:post-response {
  status: req.body.status
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
