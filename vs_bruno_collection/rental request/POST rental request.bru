meta {
  name: POST rental request
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/api/rentalRequests
  body: json
  auth: inherit
}

body:json {
  {
    "requesterName": "{{$randomFullName}}",
    "requesterEmail": "{{$randomEmail}}",
    "submissionTime": "{{$randomDateRecent}}",
    "startDate": "{{$isoTimestamp}}",
    "endDate": "{{$randomDateFuture}}",
    "requesterComments": "{{$randomAdjective}}",
    "adminComments": "{{$randomAdjective}}",
    "status": "PENDING",
    "checkoutRecord": {{checkoutrecord_id}},
    "requestedInventory": [{{inventoryitem_id}}]
  }
}

vars:post-response {
  id: res.body
  requesterName: req.body.requesterName
  requesterEmail: req.body.requesterEmail
  submissionTime: req.body.submissionTime
  startDate: req.body.startDate
  endDate: req.body.endDate
  requesterComments: req.body.requesterComments
  adminComments: req.body.adminComments
  status: req.body.status
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
