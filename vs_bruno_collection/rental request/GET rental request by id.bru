meta {
  name: GET rental request by id
  type: http
  seq: 7
}

get {
  url: {{baseURL}}/api/rentalRequests/{{id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.requesterName: eq "{{requesterName}}"
  res.body.requesterEmail: eq "{{requesterEmail}}"
  res.body.submissionTime: eq "{{submissionTime}}"
  res.body.startDate: eq "{{startDate}}"
  res.body.endDate: eq "{{endDate}}"
  res.body.requesterComments: eq "{{requesterComments}}"
  res.body.adminComments: eq "{{adminComments}}"
  res.body.status: eq "{{status}}"
  res.body.checkoutRecord: eq {{checkoutrecord_id}}
  res.body.requestedInventory: contains {{inventoryitem_id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
