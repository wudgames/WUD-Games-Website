meta {
  name: POST checkout record
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/api/checkoutRecords
  body: json
  auth: inherit
}

body:json {
  {
    "checkoutTime": "{{$isoTimestamp}}",
    "returnedTime": null,
    "peoplePlaying": {{$randomInt}},
    "resipeantName": "{{$randomFullName}}",
    "inventoryItems": [{{inventoryitem_id}}]
  }
}

vars:post-response {
  checkoutrecord_id: res.body
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
