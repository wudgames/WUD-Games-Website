meta {
  name: PUT checkout record by id
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/api/checkoutRecords/{{id}}
  body: json
  auth: inherit
}

body:json {
  {
    "checkoutTime": "{{checkoutTime}}",
    "returnedTime": "{{$isoTimestamp}}",
    "peoplePlaying": {{peoplePlaying}},
    "resipeantName": "{{resipeantName}}",
    "inventoryItems": [{{inventoryItem_id}}]
  }
}

vars:post-response {
  returnedTime: req.body.returnedTime
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
