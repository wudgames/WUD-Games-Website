meta {
  name: POST inventory item copy
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/inventoryItems
  body: json
  auth: inherit
}

body:json {
  {
    "dateAdded": "{{$isoTimestamp}}",
    "notes": "{{$randomAdjective}}",
    "currentCheckout": null,
    "genDis": {{genDis_id}}
  }
}

vars:post-response {
  inventoryItem_id: res.body
  dateAdded: req.body.dateAdded
  notes: req.body.notes
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
