meta {
  name: GET checkout record by id #2
  type: http
  seq: 7
}

get {
  url: {{baseURL}}/api/checkoutRecords/{{id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.checkoutTime: eq {{checkoutTime}}
  res.body.returnedTime: eq {{returnedTime}}
  res.body.peoplePlaying: eq {{peoplePlaying}}
  res.body.resipeantName: eq {{resipeantName}}
  res.body.inventoryItems: contains {{inventoryItem_id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
