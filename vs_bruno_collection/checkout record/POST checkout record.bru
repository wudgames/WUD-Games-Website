meta {
  name: POST checkout record
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/api/checkoutRecords
  body: json
  auth: inherit
}

body:json {
  {
    "checkoutTime": "{{$isoTimestamp}}",
    "returnedTime": null,
    "peoplePlaying": {{$randomInt}},
    "resipeantName": "{{$randomFullName}}",
    "inventoryItems": [{{inventoryItem_id}}]
  }
}

vars:post-response {
  id: res.body
  checkoutTime: req.body.checkoutTime
  peoplePlaying: req.body.peoplePlaying
  resipeantName: req.body.resipeantName
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
