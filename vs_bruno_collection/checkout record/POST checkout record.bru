meta {
  name: POST checkout record
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/checkoutRecords
  body: json
  auth: inherit
}

body:json {
  {
    "checkoutTime": "{{$isoTimestamp}}",
    "returnedTime": null,
    "peoplePlaying": {{$randomInt}},
    "resipeantName": "{{$randomFullName}}",
    "inventoryItems": []
  }
}

vars:post-response {
  resipeantName: req.body.resipeantName
  id: res.body
  peoplePlaying: res.body.peoplePlaying
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
