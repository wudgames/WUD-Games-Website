meta {
  name: POST tag
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/tags
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{$randomCatchPhraseAdjective}} {{$randomCatchPhraseNoun}}"
  }
}

vars:post-response {
  tag_name: req.body.name
  tag_id: res.body
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
