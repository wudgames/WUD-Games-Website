meta {
  name: GET general discription by id
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/api/generalDiss/{{id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.name: eq "{{name}}"
  res.body.description: eq "{{description}}"
  res.body.imageUrl: eq "{{imageUrl}}"
  res.body.tags: contains {{tag_id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
