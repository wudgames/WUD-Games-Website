meta {
  name: POST general description
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/api/generalDiss
  body: json
  auth: none
}

body:json {
  {
    "name": "{{$randomCatchPhraseAdjective}} {{$randomCatchPhraseNoun}}",
    "description": "{{$randomCatchPhraseAdjective}}",
    "imageUrl": "{{$randomCatsImage}}",
    "tags": [{{tag_id}}]
  }
}

vars:post-response {
  id: res.body
  name: req.body.name
  description: req.body.description
  imageUrl: req.body.imageUrl
}

assert {
  res.status: eq 201
}
