meta {
  name: GET game expantion discription by id
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/api/gameExpansionDiss/{{id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.id: eq {{id}}
  res.body.baseGameDis: eq {{gameDis_id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
