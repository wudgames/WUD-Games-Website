meta {
  name: POST game expansion description
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/api/gameExpansionDiss
  body: json
  auth: inherit
}

body:json {
  {
    "baseGameDis": {{gameDis_id}}
  }
}

vars:post-response {
  id: res.body
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
