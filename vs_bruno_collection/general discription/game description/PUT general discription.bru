meta {
  name: PUT general discription
  type: http
  seq: 2
}

put {
  url: {{baseURL}}/api/generalDiss/{{id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{$randomCatchPhraseAdjective}} {{$randomCatchPhraseNoun}}",
    "description": "{{$randomCatchPhraseAdjective}}",
    "imageUrl": "{{$randomCatsImage}}",
    "tags": []
  }
}

vars:post-response {
  name: req.body.name
  description: req.body.description
  imageUrl: req.body.imageUrl
}

assert {
  res.status: eq 200
  res.body: eq {{id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
