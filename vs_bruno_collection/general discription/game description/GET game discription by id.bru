meta {
  name: GET game discription by id
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/api/gameDiss/{{id}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.id: eq {{id}}
  res.body.minPlayers: eq {{minPlayers}}
  res.body.maxPlayers: eq {{maxPlayers}}
}

settings {
  encodeUrl: true
  timeout: 0
}
